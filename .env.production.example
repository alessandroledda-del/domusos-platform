DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=domusos.example.com,api.domusos.example.com
CORS_ALLOWED_ORIGINS=https://domusos.example.com
CSRF_TRUSTED_ORIGINS=https://domusos.example.com,https://api.domusos.example.com

POSTGRES_DB=domusos
POSTGRES_USER=domusos
POSTGRES_PASSWORD=replace-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

USE_S3=1
AWS_ACCESS_KEY_ID=replace-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-s3-secret-key
AWS_STORAGE_BUCKET_NAME=domusos-production
AWS_S3_ENDPOINT_URL=https://s3.example.com
AWS_S3_REGION_NAME=eu-south-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_USE_SSL=1

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
ANTIVIRUS_ENABLED=1

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=DomusOS <noreply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-smtp-user
EMAIL_HOST_PASSWORD=replace-smtp-password
EMAIL_USE_TLS=1

PAYMENT_PROVIDER=MOCK
PAYMENT_WEBHOOK_SECRET=replace-payment-webhook-secret
OUTBOUND_WEBHOOK_SECRET=replace-outbound-webhook-secret

NEXT_PUBLIC_API_URL=https://api.domusos.example.com/api
FRONTEND_URL=https://domusos.example.com

SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
RATE_LIMIT_ENABLED=1
